{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  // Les specs Vitest ne sont pas transpilées vers dist : elles ne servent qu'au
  // runner, qui lit directement le TypeScript.
  "exclude": ["node_modules", "dist", "src/**/*.spec.ts"]
}
