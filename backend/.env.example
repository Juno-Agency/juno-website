# --- JUNO backend environment ---
NODE_ENV=development
PORT=3000

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://juno:juno@localhost:5432/juno?schema=public

# Auth (back office)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Comma-separated list of allowed CORS origins (frontend dev server, prod domain)
CORS_ORIGINS=http://localhost:4200,http://localhost:8080

# Seed credentials (npm run seed)
ADMIN_EMAIL=admin@juno.studio
ADMIN_PASSWORD=change-me
