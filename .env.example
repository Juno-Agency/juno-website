# ============================================================
# JUNO — docker-compose environment
# Copy to `.env` and adjust before `docker compose up`.
# ============================================================

# --- MongoDB (Prisma requires a replica set; compose runs a single-node RS) ---
MONGO_USER=root
MONGO_PASSWORD=juno
MONGO_DB=juno
MONGO_PORT=27017

# --- Backend API ---
BACKEND_PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# Origins allowed to call the API (the frontend container is served on 8080)
CORS_ORIGINS=http://localhost:8080

# Seed the back-office admin user on first boot
RUN_SEED=true
ADMIN_EMAIL=admin@juno.studio
ADMIN_PASSWORD=change-me

# --- Frontend (nginx) ---
FRONTEND_PORT=8080

# --- Back-office (nginx, dedicated container) ---
BACKOFFICE_PORT=8090

# --- E-mails transactionnels (Resend) ---
# Clé API Resend. Laisser vide en local : les mails sont alors seulement loggés
# (aucun envoi réel), le formulaire continue de fonctionner.
RESEND_API_KEY=
# Expéditeur. En prod, le domaine doit être vérifié dans Resend.
# `onboarding@resend.dev` est le bac à sable Resend (livre uniquement au proprio du compte).
MAIL_FROM=JUNO <onboarding@resend.dev>
# Optionnel : adresse de réponse pour le récap client.
MAIL_REPLY_TO=
# Destinataires de la notif interne (toi, Juno, Noah…), séparés par des virgules.
MAIL_INTERNAL_RECIPIENTS=dietschyjulien@gmail.com,agencyjuno@gmail.com,daennoah@gmail.com
# Optionnel : URL du back-office pour le bouton "Ouvrir la demande" dans la notif.
BACKOFFICE_URL=
