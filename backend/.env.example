# --- JUNO backend environment ---
NODE_ENV=development
PORT=3000

# MongoDB connection string used by Prisma (Prisma requires a replica set).
# Local (docker compose):
DATABASE_URL=mongodb://root:juno@localhost:27017/juno?authSource=admin&directConnection=true

# Base dédiée aux tickets du back-office. Laissez vide en production : le
# backlog vit alors dans DATABASE_URL, avec le reste.
#
# En développement, la renseigner avec l'URI Atlas branche le backlog partagé
# (celui que voient Noah et Julien) tout en gardant leads et portfolio en local.
# Utilisez un utilisateur Atlas dédié, limité aux collections `tickets` et
# `counters` : celui de l'application donnerait aussi accès aux leads.
# TICKETS_DATABASE_URL=mongodb+srv://juno-tickets:<motdepasse>@<cluster>.mongodb.net/juno?retryWrites=true&w=majority
# Prod (MongoDB Atlas): mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/juno?retryWrites=true&w=majority

# Auth (back office)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Comma-separated list of allowed CORS origins (frontend dev server, prod domain)
CORS_ORIGINS=http://localhost:4200,http://localhost:8080

# Back-office admin — checked directly against these (no database user).
# In production both are REQUIRED (the API refuses to boot without them).
ADMIN_EMAIL=admin@juno.studio
ADMIN_PASSWORD=change-me

# --- E-mails transactionnels (Resend) ---
# Clé API Resend. Vide en local = mails seulement loggés (aucun envoi réel).
RESEND_API_KEY=
# Expéditeur. Domaine vérifié dans Resend requis en prod (ex. contact@agency-juno.com).
# `onboarding@resend.dev` = bac à sable (livre uniquement au proprio du compte Resend).
MAIL_FROM=JUNO <onboarding@resend.dev>
# Optionnel : adresse de réponse du récap client.
MAIL_REPLY_TO=
# Destinataires de la notif interne, séparés par des virgules (toi, Juno, Noah…).
MAIL_INTERNAL_RECIPIENTS=
# Optionnel : URL du back-office pour le bouton "Ouvrir la demande".
BACKOFFICE_URL=
# Signature secret du webhook Resend (Dashboard Resend → Webhooks). Vide = vérif désactivée (dev).
RESEND_WEBHOOK_SECRET=
# Anti-spam : temps minimum (ms) de remplissage du formulaire côté humain.
ANTISPAM_MIN_FILL_MS=2500

# --- Portfolio image storage (Cloudflare R2, S3-compatible) ---
# Laisser vide = upload d'images désactivé. Les 3 clés sont des SECRETS.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=juno-portfolio
# Domaine public qui sert les images (custom domain du bucket), ex. https://cdn.agency-juno.com
R2_PUBLIC_BASE_URL=
