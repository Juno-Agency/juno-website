# ============================================================
# JUNO — docker-compose environment
# Copy to `.env` and adjust before `docker compose up`.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=juno
POSTGRES_PASSWORD=juno
POSTGRES_DB=juno
POSTGRES_PORT=5432

# --- Backend API ---
BACKEND_PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# Origins allowed to call the API (the frontend container is served on 8080)
CORS_ORIGINS=http://localhost:8080

# Seed the back-office admin user on first boot
RUN_SEED=true
ADMIN_EMAIL=admin@juno.studio
ADMIN_PASSWORD=change-me

# --- Frontend (nginx) ---
FRONTEND_PORT=8080

# --- Back-office (nginx, dedicated container) ---
BACKOFFICE_PORT=8090

# --- Adminer (DB UI, dev only) ---
ADMINER_PORT=8081
