# --- JUNO backend environment ---
NODE_ENV=development
PORT=3000

# MongoDB connection string used by Prisma (Prisma requires a replica set).
# Local (docker compose):
DATABASE_URL=mongodb://root:juno@localhost:27017/juno?authSource=admin&directConnection=true
# Prod (MongoDB Atlas): mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/juno?retryWrites=true&w=majority

# Auth (back office)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Comma-separated list of allowed CORS origins (frontend dev server, prod domain)
CORS_ORIGINS=http://localhost:4200,http://localhost:8080

# Seed credentials (npm run seed)
ADMIN_EMAIL=admin@juno.studio
ADMIN_PASSWORD=change-me
